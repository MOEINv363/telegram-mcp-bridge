# ===== Telegram MCP Bridge — Configuration =====
# Copy this file to config.env and fill in your values.
# config.env is git-ignored — never commit it!

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# (Optional) Allowlist of Telegram user IDs that may use the bot.
# Comma-separated. Leave empty to allow everyone.
ALLOWED_USER_IDS=

# SSE port for the MCP server (Claude connects to http://127.0.0.1:PORT/sse)
SSE_PORT=8765

# Auto-reply LLM (OpenAI-compatible API)
AUTO_REPLY_API_KEY=your_api_key_here
AUTO_REPLY_BASE_URL=http://localhost:20128/v1
AUTO_REPLY_MODEL=groq/llama-3.3-70b-versatile
AUTO_REPLY_FALLBACK_MODEL=Kimi/MiniMaxAI/MiniMax-M2.7

# Vision model used to analyze photos sent to the bot
VISION_MODEL=gemini/gemini-3.6-flash

# Admin Telegram user ID — receives report notifications
ADMIN_ID=your_telegram_id

# Messages containing this keyword are routed to the Claude session instead of auto-reply
CLAUDE_KEYWORD=claude
